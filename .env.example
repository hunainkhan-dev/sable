# --- Production (Vercel) ---
# Vercel Postgres sets POSTGRES_URL automatically when you attach a database.
# For Neon/Supabase/any Postgres, set DATABASE_URL instead.
POSTGRES_URL=
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# JWT signing secret — set a long random value in production (keeps logins valid across restarts).
SABLE_SECRET=

# --- Local dev ---
# Leave POSTGRES_URL/DATABASE_URL empty to use the built-in SQLite database (no setup needed).
